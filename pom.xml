<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.github.lorenzobettini</groupId>
	<artifactId>emf-model-generator-ocl-parent</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>EMF Model Generator OCL</name>
	<description>Headless post-generation OCL validation companion for EMF Model Generator</description>
	<url>https://github.com/LorenzoBettini/emf-model-generator-ocl</url>
	<licenses>
		<license>
			<name>Eclipse Public License - v 2.0</name>
			<url>https://www.eclipse.org/legal/epl-2.0/</url>
		</license>
	</licenses>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
		<tycho.version>5.0.4</tycho.version>
		<jacoco.version>0.8.15</jacoco.version>
		<maven.antrun.version>3.2.0</maven.antrun.version>
		<!--
		Disable m2e-apt automatic configuration to avoid generated .classpath entries in Visual Studio Code Maven extension
		See https://github.com/eclipse-m2e/m2e-core/tree/main/org.eclipse.m2e.apt.ui
		-->
		<m2e.apt.activation>disabled</m2e.apt.activation>
	</properties>
	<modules>
		<module>releng/io.github.lorenzobettini.emfmodelgenerator.ocl.target</module>
		<module>bundles/io.github.lorenzobettini.emfmodelgenerator.ocl</module>
		<module>tests/io.github.lorenzobettini.emfmodelgenerator.ocl.tests</module>
		<module>features/io.github.lorenzobettini.emfmodelgenerator.ocl.feature</module>
		<module>features/io.github.lorenzobettini.emfmodelgenerator.ocl.source.feature</module>
		<module>releng/io.github.lorenzobettini.emfmodelgenerator.ocl.repository</module>
		<module>releng/io.github.lorenzobettini.emfmodelgenerator.ocl.quality</module>
	</modules>
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-surefire-plugin</artifactId>
					<version>${tycho.version}</version>
					<configuration>
						<useUIHarness>false</useUIHarness>
						<useUIThread>false</useUIThread>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho.version}</version>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<target>
						<file>
							${project.basedir}/../../releng/io.github.lorenzobettini.emfmodelgenerator.ocl.target/emf-model-generator-ocl.target
						</file>
					</target>
					<executionEnvironment>JavaSE-21</executionEnvironment>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
