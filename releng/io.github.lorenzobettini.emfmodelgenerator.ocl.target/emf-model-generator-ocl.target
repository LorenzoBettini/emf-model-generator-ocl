<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="EMF Model Generator OCL" sequenceNumber="1">
	<locations>
		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="false" type="InstallableUnit">
			<repository location="https://download.eclipse.org/releases/2026-06"/>
			<unit id="org.eclipse.equinox.core.feature.feature.group"/>
			<unit id="org.eclipse.equinox.launcher"/>
			<unit id="junit-jupiter-api"/>
			<unit id="junit-jupiter-engine"/>
			<unit id="junit-platform-suite-api"/>
			<unit id="junit-platform-suite-engine"/>
		</location>
		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="false" type="InstallableUnit">
			<repository location="https://download.eclipse.org/modeling/mdt/ocl/builds/release/6.24.0"/>
			<unit id="org.eclipse.ocl.pivot"/>
			<unit id="org.eclipse.ocl.xtext.essentialocl"/>
			<unit id="org.eclipse.ocl.xtext.completeocl"/>
			<unit id="org.eclipse.ocl.xtext.oclinecore"/>
		</location>
		<location includeDependencyDepth="none" includeDependencyScopes="compile" includeSource="true" missingManifest="generate" type="Maven">
			<dependencies>
				<dependency>
					<groupId>io.github.lorenzobettini</groupId>
					<artifactId>emf-model-generator</artifactId>
					<version>1.1.0</version>
					<type>jar</type>
				</dependency>
			</dependencies>
		</location>
	</locations>
</target>
