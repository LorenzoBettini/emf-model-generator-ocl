<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>io.github.lorenzobettini</groupId>
		<artifactId>emf-model-generator-ocl-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../..</relativePath>
	</parent>
	<artifactId>io.github.lorenzobettini.emfmodelgenerator.ocl.quality</artifactId>
	<packaging>pom</packaging>
	<name>EMF Model Generator OCL Quality Report</name>
	<profiles>
		<profile>
			<id>jacoco</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>${maven.antrun.version}</version>
						<executions>
							<execution>
								<id>jacoco-report-and-check</id>
								<phase>verify</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target xmlns:jacoco="antlib:org.jacoco.ant">
										<taskdef uri="antlib:org.jacoco.ant"
											resource="org/jacoco/ant/antlib.xml"
											classpathref="maven.plugin.classpath"/>
										<mkdir dir="${project.build.directory}/site/jacoco"/>
										<jacoco:report>
											<executiondata>
												<file file="${project.basedir}/../../tests/io.github.lorenzobettini.emfmodelgenerator.ocl.tests/target/jacoco.exec"/>
											</executiondata>
											<structure name="EMF Model Generator OCL">
											<classfiles>
												<fileset dir="${project.basedir}/../../bundles/io.github.lorenzobettini.emfmodelgenerator.ocl/target/classes"/>
												</classfiles>
												<sourcefiles encoding="UTF-8">
													<fileset dir="${project.basedir}/../../bundles/io.github.lorenzobettini.emfmodelgenerator.ocl/src"/>
												</sourcefiles>
											</structure>
											<html destdir="${project.build.directory}/site/jacoco"/>
											<xml destfile="${project.build.directory}/site/jacoco/jacoco.xml"/>
											<csv destfile="${project.build.directory}/site/jacoco/jacoco.csv"/>
											<check>
												<rule element="BUNDLE">
													<limit counter="LINE" value="COVEREDRATIO"
														minimum="1.00"/>
													<limit counter="BRANCH" value="COVEREDRATIO"
														minimum="1.00"/>
												</rule>
											</check>
										</jacoco:report>
									</target>
								</configuration>
							</execution>
						</executions>
						<dependencies>
							<dependency>
								<groupId>org.jacoco</groupId>
								<artifactId>org.jacoco.ant</artifactId>
								<version>${jacoco.version}</version>
							</dependency>
						</dependencies>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
